# =============================================================================
#  Semantic Document Discovery  –  Environment Configuration
# =============================================================================
#  Copy this file as .env and adjust values for your environment.
#  Lines starting with # are comments.  All values shown are the defaults
#  used when the variable is absent.
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=Semantic Document Discovery
APP_VERSION=1.0.0
DEBUG=false

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── CORS (comma-separated origins) ──────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:8000"]

# ── Data & Storage Paths ────────────────────────────────────────────────────
BASE_DATA_FOLDER=./Downloads
VECTORSTORE_PATH=./vectorstore_index

# ── File Upload ─────────────────────────────────────────────────────────────
ALLOWED_EXTENSIONS=[".txt",".pdf",".docx",".xlsx",".csv",".pptx",".html",".htm",".md"]

# ── LLM / Ollama ────────────────────────────────────────────────────────────
LLM_MODEL_NAME=qwen2.5:7b
LLM_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text:latest
DINMS=768
LLM_TIMEOUT_SECONDS=120

# ── Document Processing ─────────────────────────────────────────────────────
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=200
DEFAULT_LINES_PER_PAGE=50

# ── Agentic RAG ─────────────────────────────────────────────────────────────
MAX_QUERY_RETRIES=2
CONVERSATION_DB_PATH=./conversations.db
SUMMARY_MESSAGE_THRESHOLD=10

# ── Long-term Memory (LangMem) ───────────────────────────────────────────
MEMORY_STORE_PATH=./memory_store.json

# ── Hash Registry Database ──────────────────────────────────────────────────
HASH_REGISTRY_DB_URL=sqlite:///./hash_registry.db

# ── Background Sync ─────────────────────────────────────────────────────────
SYNC_INTERVAL_SECONDS=120

# ── Security (legacy JWT – change in production) ────────────────────────────
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Admin Authentication ────────────────────────────────────────────────────
ADMIN_SUPERUSER_USERNAME=admin
ADMIN_SUPERUSER_PASSWORD=Admin@12345
ADMIN_JWT_SECRET_KEY=admin-super-secret-key-change-in-production
ADMIN_TOKEN_EXPIRE_MINUTES=60
ADMIN_DB_URL=sqlite:///./admin.db
