# =============================================================================
#  Semantic Document Discovery  –  Environment Configuration
# =============================================================================
#  Copy this file to .env and adjust values for your environment.
#  Lines starting with # are comments.  All values shown are the defaults
#  used when the variable is absent.
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=Semantic Document Discovery
APP_VERSION=1.0.0
DEBUG=false

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── CORS (comma-separated origins) ──────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:8000"]

# ── Data & Storage Paths ────────────────────────────────────────────────────
# BASE_DATA_FOLDER=./Data
# VECTORSTORE_PATH=./vectorstore_index

# ── File Upload ─────────────────────────────────────────────────────────────
# ALLOWED_EXTENSIONS=[".txt",".pdf",".docx",".xlsx",".csv",".pptx",".html",".htm",".md"]

# ── LLM / Ollama (Local Mode Defaults) ──────────────────────────────────────
# These settings are used when the admin panel toggle "Use Remote Models" is OFF.
# When remote mode is ON, provider/model/API key are configured in the admin panel.
LLM_MODEL_NAME=llama3.1:8b
LLM_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text:latest
DINMS=768
LLM_TIMEOUT_SECONDS=120

# ── Remote Model Providers (configured via Admin Panel) ─────────────────────
# Remote model switching is done entirely through the admin panel at
# /chat/admin/settings.  Toggle "Use Remote Models" ON, then select a
# provider (OpenAI, Anthropic, Google GenAI, Groq, Mistral) and enter your
# API key.  No env vars needed — everything is stored encrypted in the DB.

# ── Document Processing ─────────────────────────────────────────────────────
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=200
DEFAULT_LINES_PER_PAGE=50

# ── Agentic RAG ─────────────────────────────────────────────────────────────
MAX_QUERY_RETRIES=2
# CONVERSATION_DB_PATH=./conversations.db
SUMMARY_MESSAGE_THRESHOLD=10

# ── Long-term Memory (LangMem) ───────────────────────────────────────────
MEMORY_STORE_PATH=./memory_store.json

# ── Hash Registry Database ──────────────────────────────────────────────────
HASH_REGISTRY_DB_URL=sqlite:///./hash_registry.db

# ── Background Sync ─────────────────────────────────────────────────────────
SYNC_INTERVAL_SECONDS=120

# ── Security (CHANGE THESE IN PRODUCTION) ───────────────────────────────────
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Admin Authentication (CHANGE THESE IN PRODUCTION) ───────────────────────
ADMIN_SUPERUSER_USERNAME=admin
ADMIN_SUPERUSER_PASSWORD=ChangeMeInProduction!
ADMIN_JWT_SECRET_KEY=change-this-admin-secret-key-in-production
ADMIN_TOKEN_EXPIRE_MINUTES=60
ADMIN_DB_URL=sqlite:///./admin.db
